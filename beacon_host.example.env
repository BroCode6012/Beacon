# Beacon host settings — WHERE Beacon lives. Copy to beacon_host.env on the machine it describes.
#
# One file per machine: the laptop needs none (every default is the laptop's layout); a server
# gets one written by deploy/server/install.sh. Moving Beacon to a better host = install there,
# copy the library with beacon_move.py, and this file is the only machine-specific part.
# Real values in the environment always win over this file. NEVER commit the real file:
# on a server it holds the data service's keys.

# The shared engine (the folder that contains scripter/). Default: a Quill/ folder beside Beacon/.
FACELESS_ENGINE_DIR=/opt/beacon/current/Quill

# The library — the one database. Both names are read by different parts of the engine.
YOUTUBE_INDEX_DB=/var/lib/beacon/data/youtube_index.sqlite3
SIGNAL_INDEX_DB=/var/lib/beacon/data/youtube_index.sqlite3

# The operator's clock. A server runs in UTC; without this every "updated 11:30" is an hour off.
TZ=Africa/Casablanca

# Beacon's data service (the finder). 127.0.0.1 = only this machine can reach it.
FINDER_HOST=127.0.0.1
FINDER_PORT=8765
# Long random keys on any machine reachable by others. The laptop's defaults are words written
# in the source — fine on 127.0.0.1 of a personal laptop, never on a server.
FINDER_TOKEN=change-me-to-a-long-random-key
FINDER_READ_TOKEN=change-me-to-another-long-random-key
FINDER_TOKEN_FILE=/var/lib/beacon/storage/finder.tokens.json
FINDER_LOG=/var/lib/beacon/storage/finder_service.log

# The scraper runs as this machine's service; the Overview's Start/Stop drive it.
BEACON_RADAR_UNIT=beacon-radar.service

# Beacon's screens as a web app (a server has no window to open).
FLET_FORCE_WEB_SERVER=1
FLET_SERVER_IP=127.0.0.1
FLET_SERVER_PORT=8570

# The door for outside agents (Muse). "read" = look only; "agent" = everything Beacon's own agent
# may do, every change recorded with its undo (muse_powers.py). An operator's decision per machine.
BEACON_GATEWAY_PORT=8770
BEACON_GATEWAY_ACCESS=read
# When an agent works on Beacon from outside, name it: the Agent tab then introduces it and lists
# its changes with Undo, instead of asking for an in-app AI. Leave empty when there is none.
BEACON_OUTSIDE_AGENT=
BEACON_OUTSIDE_AGENT_URL=
# How old the shared "Index snapshot" count may get before a quiet recount (seconds).
BEACON_INDEX_STATS_REFRESH=3600

# Autopilot spends AI usage — keep it off on a fresh host until the switch-over.
SIGNAL_DISABLE_AUTOPILOT=1
