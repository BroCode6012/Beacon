# Copy to /etc/signal-edge/edge.env, then replace placeholders privately.
# Never commit or paste the completed file into chat, logs, or shell history.
SIGNAL_EDGE_SIGNING_KEY=replace-with-a-long-random-shared-secret
YOUTUBE_API_KEYS=replace-with-comma-separated-authorized-keys
# Optional concurrency ceiling. The worker otherwise uses one concurrent lane
# per healthy key, up to its built-in safety cap.
YOUTUBE_API_WORKERS=16
SIGNAL_EDGE_NODE_ID=oracle-casablanca-1
