# Beacon's public front door (Caddy). Rendered to /etc/caddy/Caddyfile on the server.
#
#   @ADDRESS@       the server's public address — an IP works: Let's Encrypt issues 6-day IP
#                   certificates (generally available since 2026-01-15) and Caddy renews them
#   @SITES@         every address the site answers on: the IP plus any names given with
#                   --name. Some clients refuse bare IPs (Muse's connector: "only a public
#                   domain name"), and 51-170-132-206.sslip.io is a free, no-account name
#                   for the same IP.
#   @PWHASH@        bcrypt hash of the web password (`caddy hash-password`, fed on stdin);
#                   the plain password never reaches the server
#   @WEB_PORT@      Beacon's web screens (FLET_SERVER_PORT, 127.0.0.1 only)
#   @GATEWAY_PORT@  Muse's door (BEACON_GATEWAY_PORT, 127.0.0.1 only)
#
# Beacon itself still listens only on 127.0.0.1; this is the one thing facing the internet.

{
	# Browsers never send a site name (SNI) when the address is a bare IP, so Caddy could not
	# pick a certificate and every visit failed with "TLS internal error" (2026-09-29).
	default_sni @ADDRESS@
}

@SITES@ {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	# Muse's door has its own long key (checked by beacon_gateway.py), so no password prompt
	# in front of it — and a permanent address, unlike a quick tunnel's.
	handle_path /muse/* {
		reverse_proxy 127.0.0.1:@GATEWAY_PORT@
	}

	# Everything else is Beacon's screens, behind the password.
	handle {
		basic_auth {
			beacon @PWHASH@
		}
		reverse_proxy 127.0.0.1:@WEB_PORT@
	}

	log {
		output file /var/log/caddy/beacon-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
